# trade-alert cron schedule (SSOT §5)
# Executed by supercronic inside the cron container.
# Uses pipeline_runner.py to interpret YAML workflow DSL.
# Container TZ=America/New_York — all times are ET (DST-aware).

TZ=America/New_York

# ── 15m pipeline — US market hours Mon-Fri 9:30-16:00 ET ────────────────────
# flock prevents overlapping runs if a pipeline exceeds 15 min (MCP timeouts, high volatility).
30,45 9 * * 1-5 flock -n /tmp/orchestrator-15m.lock -c 'cd /app && python pipeline_runner.py workflows/orchestrator-15m.yaml >> /app/logs/cron.log 2>&1'
*/15 10-15 * * 1-5 flock -n /tmp/orchestrator-15m.lock -c 'cd /app && python pipeline_runner.py workflows/orchestrator-15m.yaml >> /app/logs/cron.log 2>&1'
0 16 * * 1-5 flock -n /tmp/orchestrator-15m.lock -c 'cd /app && python pipeline_runner.py workflows/orchestrator-15m.yaml >> /app/logs/cron.log 2>&1'

# ── 1h pipeline — market hours Mon-Fri 10:00-16:00 ET ───────────────────────
0 10-16 * * 1-5 flock -n /tmp/orchestrator-1h.lock -c 'cd /app && python pipeline_runner.py workflows/orchestrator-1h.yaml >> /app/logs/cron.log 2>&1'

# ── Outcome tracker — extended hours for position resolution ─────────────────
*/15 9-18 * * 1-5 flock -n /tmp/outcome-tracker.lock -c 'cd /app && python pipeline_runner.py workflows/outcome-tracker.yaml >> /app/logs/cron.log 2>&1'

# ── State summaries — pre-open (9:15 ET) and post-close (16:10 ET) ──────────
15 9 * * 1-5 cd /app && python pipeline_runner.py workflows/state-summary.yaml >> /app/logs/cron.log 2>&1
10 16 * * 1-5 cd /app && python pipeline_runner.py workflows/state-summary.yaml >> /app/logs/cron.log 2>&1

# ── EOD summary — 4:20 PM ET Mon-Fri (staggered after state-summary) ─────────
20 16 * * 1-5 cd /app && python eod_summary.py >> /app/logs/cron.log 2>&1

# ── Data retention — Sunday 03:00 ET ─────────────────────────────────────────
0 3 * * 0 cd /app && python scripts/purge_old_data.py >> /app/logs/cron.log 2>&1

# ── Langfuse dataset purge — Sunday 02:00 ET ─────────────────────────────────
0 2 * * 0 cd /app && python scripts/purge_langfuse_datasets.py >> /app/logs/cron.log 2>&1

# ── Healthcheck — every 15 min, 24/7 ────────────────────────────────────────────
*/15 * * * * cd /app && python healthcheck.py >> /app/logs/health.log 2>&1

# ── Log rotation — daily at midnight, keep last 7 days ────────────────────────
0 0 * * * cd /app/logs && tail -50000 health.jsonl > health.jsonl.tmp && mv health.jsonl.tmp health.jsonl 2>/dev/null; tail -50000 cron.log > cron.log.tmp && mv cron.log.tmp cron.log 2>/dev/null
