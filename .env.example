# trade-alert environment configuration (non-secret tunables)
# Copy to .env and adjust as needed.
# For secrets (API keys, passwords, tokens), see .env.secrets.example
#
# ─── SECRETS MANAGEMENT ─────────────────────────────────────
# Option A (Vault — recommended for production):
#   1. Start Vault:  docker compose up vault -d
#   2. Run:  ./scripts/vault-init.sh      (migrates .env.secrets → Vault)
#   3. Keep only VAULT_ADDR, VAULT_TOKEN in .env.secrets and tunables here.
#
# Option B (env files — local dev):
#   Fill in .env.secrets with credentials. Leave VAULT_ADDR empty.
# ─────────────────────────────────────────────────────────────

# ── Connection URLs ─────────────────────────────────────────────
# NOTE: In Docker, override these to use container service names:
#   REDIS_URL=redis://redis:6379
#   DATABASE_URL=postgresql://trade_alert:<password>@postgres:5432/trade_alert
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://trade_alert:password@localhost:5432/trade_alert

# ── Phase 8: Outcome Tracker ───────────────────────────────────
POLYGON_API_KEY=
OUTCOME_WINDOW_HOURS=4
PRICE_POLL_INTERVAL=60

# ── Tunable Thresholds ─────────────────────────────────────────
VIX_RISK_THRESHOLD=25.0
CURVE_RISK_THRESHOLD=-25.0
FALLBACK_EQUITIES=AAPL,MSFT,NVDA,TSLA,SPY,QQQ,AMD,META,AMZN,GOOGL
REDIS_SNAPSHOT_TTL=1200
MERGER_TOP_N=20

# ── Gate Thresholds (tune decision gates without code changes) ──
GATE_EP_15M=0.70
GATE_EP_1H=0.75
GATE_SA=3
GATE_CONF=0.75
MACRO_VETO_SA=6
MACRO_VETO_EP=0.90

# ── Remote / VPS Deployment ─────────────────────────────────────
# Override these when running on a remote host (not localhost).
# On localhost / Docker Desktop, the defaults work without changes.
NEXTAUTH_URL=http://localhost:3000
# LANGFUSE_HOST is set inside docker-compose to http://langfuse:3000
# Override only if Langfuse runs on a separate host or Langfuse Cloud:
# LANGFUSE_HOST=https://cloud.langfuse.com

# Port bindings — services default to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 only if you need external access AND have a firewall.
# VAULT_BIND=127.0.0.1
# REDIS_BIND=127.0.0.1
# POSTGRES_BIND=127.0.0.1
# LANGFUSE_DB_BIND=127.0.0.1
# MCP_BIND=127.0.0.1        # MCP servers (8001-8011), default loopback
# LANGFUSE_BIND=0.0.0.0     # Langfuse UI (:3000), default all interfaces
# DASHBOARD_BIND=0.0.0.0    # Dashboard  (:8080), default all interfaces

# Langfuse internal DB (defaults work out-of-the-box; override for production):
# LANGFUSE_DB_NAME=langfuse
# LANGFUSE_DB_USER=langfuse
# LANGFUSE_DB_PASSWORD=langfuse
VIX_SOFT_THRESHOLD=25.0
VIX_SOFT_SA=4
VIX_SOFT_EP=0.80

# ── Pipeline Tuning ────────────────────────────────────────────
MCP_TIMEOUT=30.0
MCP_HEALTH_TIMEOUT=5.0
MCP_HEALTH_RETRIES=2
REDIS_SOCKET_TIMEOUT=10.0
REDIS_DEDUP_TIMEOUT=5.0
DISCORD_HTTP_TIMEOUT=10.0

# ── MCP Servers ─────────────────────────────────────────────────
# 11 MCP servers (ports 8001-8011) run live API integrations. No API key needed for:
#   TradingView (8001), SpamShield (8010).
# Free-tier keys needed for: Polygon, Finnhub, FRED, EDGAR, YFinance, Alpaca
#   (see .env.secrets.example).
# Servers degrade gracefully when optional API keys are missing.

# ── Langfuse Observability ──────────────────────────────────────
# Self-hosted Langfuse instance (started via docker compose).
LANGFUSE_HOST=http://localhost:3000

# ── Trace Analyzer Thresholds ───────────────────────────────────
TRACE_COST_BUDGET=0.50
TRACE_LATENCY_MAX=120

# ── Macro Normalizer ───────────────────────────────────────────
VIX_EXTREME_THRESHOLD=30.0
VIX_ELEVATED_THRESHOLD=20.0

# ── Dashboard ──────────────────────────────────────────────────
DASHBOARD_CORS_ORIGINS=http://localhost:3000

# ── Alert Quality Controls ──────────────────────────────────────
# Dedup window: suppress duplicate alerts (same symbol/direction/timeframe)
DEDUP_WINDOW_SECONDS=900
# Max alerts sent to Discord per pipeline cycle (prevents spam)
MAX_ALERTS_PER_CYCLE=5

# ── Langfuse Prompt Management ──────────────────────────────────
# Decision prompts are managed in the Langfuse UI under:
#   • decision-system  (system prompt)
#   • decision-user    (user prompt with {{variables}})
# Prompts are fetched with label="production". If Langfuse is
# unavailable, built-in YAML-equivalent fallbacks are used.
# See: ./scripts/langfuse-setup.sh for initial prompt seeding.
