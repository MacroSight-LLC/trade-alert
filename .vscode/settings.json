{
    // ============================================================
    // PYTHON INTERPRETER & ENVIRONMENT
    // ============================================================
    "python.defaultInterpreterPath": "/home/taylor/trade-alert/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.envFile": "${workspaceFolder}/.env",
    // ============================================================
    // RUFF FORMATTER
    // ============================================================
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "ruff.configurationPreference": "filesystemFirst",
    "ruff.lint.enable": true,
    // ============================================================
    // PYLANCE / ANALYSIS
    // ============================================================
    "python.analysis.extraPaths": [
        "${workspaceFolder}/src"
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.exclude": [
        "**/node_modules",
        "**/.venv",
        ".venv",
        "src/cuga",
        "src/cuga/**",
        "src/frontend_workspaces",
        "src/system_tests",
        "src/scripts",
        "data",
        "logs"
    ],
    "python.analysis.ignore": [
        "**/node_modules",
        "**/.venv",
        ".venv/**",
        "src/cuga/**",
        "src/frontend_workspaces/**",
        "src/system_tests/**",
        "src/scripts/**"
    ],
    // ============================================================
    // TESTING
    // ============================================================
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "tests",
        "-v",
        "--tb=short"
    ],
    "python.testing.unittestEnabled": false,
    // ============================================================
    // EDITOR (project-specific overrides)
    // ============================================================
    "editor.rulers": [110],
    // ============================================================
    // YAML SCHEMAS
    // ============================================================
    "yaml.validate": true,
    "yaml.schemas": {
        "https://json.schemastore.org/github-workflow.json": "${workspaceFolder}/.github/workflows/*.yml",
        "https://json.schemastore.org/github-action.json": "${workspaceFolder}/action.yml"
    },
    // ============================================================
    // FILE ASSOCIATIONS
    // ============================================================
    "files.associations": {
        "*.yaml": "yaml",
        "*.yml": "yaml",
        "*.md": "markdown"
    },
    // ============================================================
    // FILES: EXCLUDE FROM EXPLORER
    // (build artifacts & caches only — never hide source folders)
    // ============================================================
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/*.pyc": true,
        "**/.DS_Store": true,
        "**/*.egg-info": true,
        ".venv": true,
        "uv.lock": true
    },
    // ============================================================
    // SEARCH: EXCLUDE FROM WORKSPACE SEARCH
    // ============================================================
    "search.exclude": {
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/node_modules": true,
        "data/postgres": true,
        "logs/": true,
        "src/cuga/": true,
        "src/frontend_workspaces/": true
    },
    // ============================================================
    // FILE WATCHER: EXCLUDE HEAVY DIRS
    // ============================================================
    "files.watcherExclude": {
        "${workspaceFolder}/.venv/**": true,
        "${workspaceFolder}/data/**": true,
        "${workspaceFolder}/logs/**": true,
        "${workspaceFolder}/src/cuga/**": true
    },
    // ============================================================
    // REST CLIENT
    // ============================================================
    "rest-client.environmentVariables": {
        "$shared": {},
        "local": {
            "baseUrl": "http://localhost:8000"
        }
    },
    // ============================================================
    // GIT
    // ============================================================
    "git.defaultRemote": "origin"
}
