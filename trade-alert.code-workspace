{
  "folders": [
    {
      "name": "trade-alert",
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.useEnvFile": true,
    "python.envFile": "${workspaceFolder}/.env",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["tests/unit"],
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true,
      "**/.pytest_cache/**": true,
      "**/.mypy_cache/**": true,
      "**/.ruff_cache/**": true,
      "**/node_modules/**": true
    },
    "search.exclude": {
      "**/.venv": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/uv.lock": true
    },
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.py[cod]": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/.coverage": true,
      "**/htmlcov": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "charliermarsh.ruff",
      "ms-python.mypy-type-checker",
      "tamasfe.even-better-toml",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml",
      "eamodio.gitlens",
      "editorconfig.editorconfig"
    ]
  }
}
