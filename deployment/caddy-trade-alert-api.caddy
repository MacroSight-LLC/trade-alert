# Caddy snippet — expose trade-alert dashboard API for static UI at www.macrosight.net/trade-alert/
# Install on Hetzner VPS; DNS A record: trade-alert-api.macrosight.net → VPS IP
#
# Requires on dashboard container:
#   DASHBOARD_CORS_ORIGINS=https://www.macrosight.net
#   DASHBOARD_API_KEY=...
#   DASHBOARD_REQUIRE_AUTH=true

trade-alert-api.macrosight.net {
	reverse_proxy 127.0.0.1:8080
}
